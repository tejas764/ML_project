FROM python:3.12-slim
WORKDIR /app
COPY requirement.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY nids_app.py /app/nids_app.py
COPY Datasets/demo_synthetic.csv /app/Datasets/demo_synthetic.csv
EXPOSE 8501
CMD ["python", "-m", "streamlit", "run", "nids_app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
